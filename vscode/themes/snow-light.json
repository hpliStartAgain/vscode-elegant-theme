    "decorator": "#7c3aed",
    "event": "#0a7ea4",
    "function": "#0969da",
    "method": "#0969da",
    "macro": "#a1421f",
    "label": "#b4249b",
    "comment": "#7b889a",
    "string": "#1a7f5a",
    "keyword": "#8250df",
