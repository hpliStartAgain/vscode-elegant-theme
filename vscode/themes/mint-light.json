  "tokenColors": [
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Control",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
        "storage.type.function",
        "keyword.declaration",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#1d4ed8"
      }
    },
    {
      "name": "Type",
      "scope": [
        "support.type",
        "entity.name.type",
        "meta.type.annotation",
        "entity.name.type.primitive",
        "storage.type.primitive",
        "support.type.primitive",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#0b7a4b"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#0e6b5c"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#4d6b1f"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#6b7a1c"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#0f6e8c"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#0a5f5a"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#2a7a62"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5c7068"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#0b7a4b"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "storage.modifier.import",
        "storage.modifier.package",
        "entity.name.type.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#4338ca"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label",
        "constant.other.label",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Doc Tag",
      "scope": [
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "comment.block.documentation entity.name.type",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#567299"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#9a3412"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a9388",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d1242f"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d1242f",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0f9f7a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#9a3412",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#233a33",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline raw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0f9f7a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d1242f"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7a9388",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#4338ca",
    "type": "#0b7a4b",
    "class": "#0e6b5c",
