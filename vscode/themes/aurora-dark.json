    "struct": "#d3f0a0",
    "typeParameter": "#c3e88d",
    "parameter": "#f2e2b5",
    "variable": "#e9d8a6",
    "variable.readonly": "#f0a6ca",
    "variable.defaultLibrary": "#f0a6ca",
    "property": "#7ec8e3",
    "enumMember": "#f0a6ca",
    "decorator": "#f7b267",
    "event": "#7ec8e3",
    "function": "#5ad4e6",
    "method": "#5ad4e6",
    "macro": "#f0a6ca",
    "label": "#4fd1c5",
    "comment": "#5a7370",
    "string": "#8fd98a",
    "keyword": "#b08cff",
    "number": "#f7b267",
    "regexp": "#7ee8c7",
    "operator": "#74c7ec",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
