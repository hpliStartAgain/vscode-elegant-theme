    "variable.readonly": "#9c27b0",
    "variable.defaultLibrary": "#9c27b0",
    "property": "#2b7a91",
    "enumMember": "#9c27b0",
    "decorator": "#7c4dbd",
    "event": "#2b7a91",
    "function": "#1565c0",
    "method": "#1565c0",
    "macro": "#a3433f",
    "label": "#0f7c6e",
    "comment": "#8e7a88",
    "string": "#2e7d32",
