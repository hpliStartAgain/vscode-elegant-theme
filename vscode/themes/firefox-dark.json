  "tokenColors": [
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7de9"
      }
    },
    {
      "name": "Control",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#ff8fb1"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
        "storage.type.function",
        "keyword.declaration",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#f59cff"
      }
    },
    {
      "name": "Type",
      "scope": [
        "support.type",
        "entity.name.type",
        "meta.type.annotation",
        "entity.name.type.primitive",
        "storage.type.primitive",
        "support.type.primitive",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#b98eff"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#cfa8ff"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#86de74"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#75bfff"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#a3d4ff"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4fe0e8"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffffb4"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff9f5c"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6b89ff"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ffd36b"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#ffb4a0"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#b8c4ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9d9db8"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6fc3ff"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffa3ef"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffe08a"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "storage.modifier.import",
        "storage.modifier.package",
        "entity.name.type.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#9fa8ff"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label",
        "constant.other.label",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4fe0e8"
      }
    },
    {
      "name": "Doc Tag",
      "scope": [
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "comment.block.documentation entity.name.type",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#a597c4"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#ff9f5c"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8f8ca6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b7f"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff6b7f",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0a84ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffb4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#cfd3ec",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline raw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6b89ff"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0a84ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#86de74"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6b7f"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#0a84ff"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8f8ca6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ff7de9"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9fa8ff",
    "type": "#b98eff",
    "class": "#cfa8ff",
    "enum": "#cfa8ff",
    "interface": "#b98eff",
    "struct": "#cfa8ff",
