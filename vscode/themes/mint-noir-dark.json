    "event": "#86efac",
    "function": "#67e8f9",
    "method": "#67e8f9",
    "macro": "#fb923c",
    "label": "#5eead4",
    "comment": "#587369",
    "string": "#7dd3fc",
    "keyword": "#34d399",
    "number": "#fb923c",
