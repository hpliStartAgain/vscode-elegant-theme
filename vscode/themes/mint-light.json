    "decorator": "#b45309",
    "event": "#0f6e8c",
    "function": "#0369a1",
    "method": "#0369a1",
    "macro": "#9a3412",
    "label": "#0e7490",
    "comment": "#7a9388",
    "string": "#15803d",
    "keyword": "#0f766e",
    "number": "#c2410c",
    "regexp": "#0a5f5a",
