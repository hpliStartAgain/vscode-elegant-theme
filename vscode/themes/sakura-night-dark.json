  "tokenColors": [
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d98cd3"
      }
    },
    {
      "name": "Control",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#ff8fab"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
        "storage.type.function",
        "keyword.declaration",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#b39ddb"
      }
    },
    {
      "name": "Type",
      "scope": [
        "support.type",
        "entity.name.type",
        "meta.type.annotation",
        "entity.name.type.primitive",
        "storage.type.primitive",
        "support.type.primitive",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#ffb7c5"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#ffc7d1"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#8ecae6"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#c7a5e8"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#d9c2f0"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#f2b5a0"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffd6a5"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ffc98a"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a8e6cf"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7fd7c4"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#9adcf0"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#d4a5d9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a594a8"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ff8fab"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffd6a5"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f6c177"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "storage.modifier.import",
        "storage.modifier.package",
        "entity.name.type.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#c4a7e7"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label",
        "constant.other.label",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7fd7c4"
      }
    },
    {
      "name": "Doc Tag",
      "scope": [
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "comment.block.documentation entity.name.type",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#9ba7c9"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#f2b5a0"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6f6070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff6b8a",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f48fb1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffd6a5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#dcc6d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline raw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a8e6cf"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#f48fb1",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a8e6cf"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8ecae6"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6f6070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d98cd3"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c4a7e7",
    "type": "#ffb7c5",
