    "variable.defaultLibrary": "#6d28d9",
    "property": "#0f766e",
    "enumMember": "#6d28d9",
    "decorator": "#7c3aed",
    "event": "#0f766e",
    "function": "#1e40af",
    "method": "#1e40af",
    "macro": "#9a3412",
    "label": "#0b6b80",
    "comment": "#93857a",
    "string": "#166534",
    "keyword": "#9a3412",
    "number": "#b45309",
    "regexp": "#0a5f70",
