    "typeParameter": "#0e7c66",
    "parameter": "#b45309",
    "variable": "#9c4221",
    "variable.readonly": "#9d174d",
    "variable.defaultLibrary": "#9d174d",
    "property": "#0a6f86",
    "enumMember": "#9d174d",
    "decorator": "#7c3aed",
    "event": "#0a6f86",
    "function": "#0369a1",
    "method": "#0369a1",
    "macro": "#9c4221",
    "label": "#0a5f70",
    "comment": "#78928e",
    "string": "#2f7d4a",
    "keyword": "#0f766e",
    "number": "#c2410c",
    "regexp": "#7c2d12",
    "operator": "#b94a3a",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
