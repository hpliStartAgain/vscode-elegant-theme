    "function": "#86de74",
    "method": "#86de74",
    "macro": "#ff9f5c",
    "label": "#4fe0e8",
    "comment": "#8f8ca6",
    "string": "#6b89ff",
    "keyword": "#ff7de9",
    "number": "#ff9f5c",
