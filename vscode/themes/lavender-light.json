  "tokenColors": [
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6d28d9"
      }
    },
    {
      "name": "Control",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
        "storage.type.function",
        "keyword.declaration",
        "keyword.other.fn",
        "keyword.other.rust",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#4338ca"
      }
    },
    {
      "name": "Type",
      "scope": [
        "support.type",
        "entity.name.type",
        "meta.type.annotation",
        "entity.name.type.primitive",
        "storage.type.primitive",
        "support.type.primitive",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#0b6b80"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#1d4ed8"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#c026d3"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#1e40af"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#9d174d"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#0b6b80"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#5b21b6"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#67617f"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#9d174d"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#c026d3"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "storage.modifier.import",
        "storage.modifier.package",
        "entity.name.type.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#3730a3"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label",
        "constant.other.label",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0b6b80"
      }
    },
    {
      "name": "Doc Tag",
      "scope": [
        "comment keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "comment.block.documentation entity.name.type",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#6f5fa8"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#857fa0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#dc2626",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6d4aff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#9d174d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2e2a44",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline raw",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6d4aff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#0969da"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#857fa0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#6d28d9"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#3730a3",
    "type": "#0b6b80",
