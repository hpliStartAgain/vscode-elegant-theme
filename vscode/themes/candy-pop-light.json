    "typeParameter": "#8f6a00",
    "parameter": "#c44a3f",
    "variable": "#c8322b",
    "variable.readonly": "#7b3fb3",
    "variable.defaultLibrary": "#7b3fb3",
    "property": "#0b7a9c",
    "enumMember": "#7b3fb3",
    "decorator": "#5c3ed6",
    "event": "#0b7a9c",
    "function": "#1a6fc9",
    "method": "#1a6fc9",
    "macro": "#b25a00",
    "label": "#0c7560",
    "comment": "#8b8f9e",
    "string": "#2f7d32",
    "keyword": "#a626a4",
    "number": "#986801",
    "regexp": "#0b6b80",
    "operator": "#2f6fa8",
    "*.deprecated": {
      "strikethrough": true
    }
  }
